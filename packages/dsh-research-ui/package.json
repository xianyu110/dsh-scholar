{
  "name": "@dsh-scholar/research-ui",
  "version": "0.1.0",
  "description": "DSH Scholar standalone research workspace with a same-origin BFF and an isolated Research Kernel sidecar.",
  "type": "module",
  "license": "BSD-3-Clause",
  "private": true,
  "files": [
    "lib/client.js",
    "lib/client.js.map",
    "lib/standalone/"
  ],
  "main": "lib/standalone/server.js",
  "types": "lib/standalone/server.d.ts",
  "exports": {
    ".": {
      "types": "./lib/standalone/server.d.ts",
      "import": "./lib/standalone/server.js",
      "default": "./lib/standalone/server.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./standalone": {
      "types": "./lib/standalone/server.d.ts",
      "import": "./lib/standalone/server.js",
      "default": "./lib/standalone/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts && node ../../scripts/verify-research-ui-bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dsh-scholar/research-kernel": "file:../research-kernel",
    "@dsh-scholar/scholar-connectors": "file:../scholar-connectors"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "0.22.2",
    "typescript": "^5.7.0"
  },
  "bin": {
    "research-ui-standalone": "./lib/standalone/server.js"
  }
}
