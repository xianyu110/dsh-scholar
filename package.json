{
  "name": "@dsh-scholar/research-plugin",
  "version": "0.1.0",
  "description": "DSH Research OS — a fully automated scientific research plugin for DSH (DeepSeek Harness): survey, idea, experiment contract, durable runner jobs, claim-evidence ledger, manuscript and release bundle.",
  "type": "module",
  "license": "BSD-3-Clause",
  "private": true,
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm -r --filter './packages/*' --filter './workers/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fault": "bash tests/fault-injection/run-fault-tests.sh",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "kernel": "node packages/research-kernel/lib/bin/kernel.js",
    "runner": "node workers/runner-gateway/lib/bin/runner.js"
  },
  "dependencies": {
    "@dsh-scholar/research-client": "file:packages/research-client",
    "@dsh-scholar/research-kernel": "file:packages/research-kernel",
    "@dsh-scholar/research-schemas": "file:packages/research-schemas",
    "@dsh-scholar/scholar-connectors": "file:packages/scholar-connectors",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc.7",
    "schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@dsh-scholar/runner-gateway": "file:workers/runner-gateway"
  }
}
